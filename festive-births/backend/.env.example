# Copy to .env for local development. On Railway set these as service variables.
ENVIRONMENT=development
DATABASE_URL=postgresql://festive:festive@localhost:5445/festive
# Production: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me-dev-insecure-change-me
CORS_ORIGINS=["http://localhost:3010"]
# Bootstrap superuser (created on first start if the Persal number doesn't exist)
SUPERUSER_PERSAL=
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=
# Festive reporting days users may capture against (JSON list of ISO dates)
REPORT_DATES=["2026-12-25","2027-01-01"]
# Season close: from this moment (SAST) all data is read-only. Default 2027-01-10T00:00.
# Viewing, exports, sign-in, password changes and admin reset/unlock/sign-out keep working.
# Set to "off" to disable, or move it, e.g. DATA_LOCK_AT=2027-01-15T00:00
DATA_LOCK_AT=2027-01-10T00:00
# New and reset accounts get a random one-time password (shown once to the administrator).
# Without SUPERUSER_PASSWORD the bootstrap superuser's one-time password is printed in the server log.
SESSION_MINUTES=30
# Absolute session cap, however active the user is
SESSION_MAX_HOURS=12
# Proxies that append to X-Forwarded-For in front of the API: 1 if the frontend reaches the backend
# over Railway private networking (recommended), 2 if it goes through a public Railway domain.
TRUSTED_PROXY_HOPS=1
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
